{
  "manifest_version": 3,
  "name": "Short Straw — global meeting planner",
  "version": "1.0.0",
  "description": "Pick cities, see everyone's local time at a glance, find the best meeting slot — and see who's drawing the short straw.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Short Straw",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
